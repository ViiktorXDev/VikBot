{
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate:prod": "npm run db:check && cross-env NODE_ENV=production tsx src/database/migrate.ts",
    "migrate:dev": "npm run db:check && cross-env NODE_ENV=development tsx src/database/migrate.ts",
    "db:check": "tsx src/database/check-schemas.ts",
    "db:generate": "npm run db:check && npx drizzle-kit generate --name",
    "db:studio": "cross-env NODE_ENV=development npx drizzle-kit studio",
    "db:studio:prod": "cross-env NODE_ENV=production npx drizzle-kit studio"
  },
  "dependencies": {
    "@grammyjs/menu": "^1.3.1",
    "@whiskeysockets/baileys": "^7.0.0-rc13",
    "better-sqlite3": "^12.10.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "grammy": "^1.43.0",
    "node-cache": "^5.1.2",
    "pg": "^8.21.0",
    "pino": "^10.3.1",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.9.1",
    "@types/node-cache": "^4.1.3",
    "@types/pg": "^8.20.0",
    "cross-env": "^10.1.0",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
